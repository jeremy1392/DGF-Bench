    "families": {
      "injection": "15 injection kinds, one variant dataset each (dgf-bench attack --placement <kind>), full-route runs",
      "document": "6 document vectors (Word core properties, signed PDF, document labels), single-gate replays",
      "crowdstrike": "6 kinds derived from the prompt-injection threats described by CrowdStrike (2026), single-gate replays",
      "adaptive": "2 adaptive campaigns: an attacker model rewrites the injection for up to 4 (v1) or 5 (v2) rounds per gate"
    },
    "sources": [
